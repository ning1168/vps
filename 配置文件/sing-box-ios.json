{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    // 出错才报；可选 warn(含警告) | info(全部连接日志,刷屏) | debug(调试)
    "level": "error",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "本地DNS"
      },
      {
        "type": "https",
        "tag": "Cloudflare-DoH",
        "server": "1.1.1.1",
        "server_port": 443,
        "detour": "手动选择"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "本地DNS"
      },
      // 示例：自定义直连域名，照此行加
      {
        "domain_suffix": ["qq.com"],
        "action": "route",
        "server": "本地DNS"
      },
      {
        "rule_set": "苹果域名",
        "action": "route",
        "server": "本地DNS"
      },
      {
        "rule_set": "微软域名",
        "action": "route",
        "server": "本地DNS"
      },
      {
        "rule_set": "国内域名",
        "action": "route",
        "server": "本地DNS"
      }
    ],
    "final": "Cloudflare-DoH",
    "strategy": "ipv4_only",
    "cache_capacity": 4096
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.18.0.1/30"],
      "auto_route": true
    }
  ],
  "outbounds": [
    // $SUB_STORE_NODES$ = 订阅节点注入点，由 merge-singbox.js 替换，勿删
    // 默认选中第一项，想固定某节点把它的 tag 移到首位
    {
      "type": "selector",
      "tag": "手动选择",
      "outbounds": ["自动选择", "$SUB_STORE_NODES$"],
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": ["$SUB_STORE_NODES$"],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "苹果服务",
      "outbounds": ["直连", "手动选择", "自动选择"]
    },
    {
      "type": "selector",
      "tag": "微软服务",
      "outbounds": ["直连", "手动选择", "自动选择"]
    },
    {
      "type": "selector",
      "tag": "谷歌服务",
      "outbounds": ["手动选择", "自动选择", "直连"]
    },
    {
      "type": "direct",
      "tag": "直连"
    },
    "$SUB_STORE_NODES$"
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
       // ↓↓↓ 模式切换（面板/仪表盘上的「模式」按钮就是靠这两条生成的）↓↓↓
      // 全局：所有流量走代理（想固定某个节点，把 outbound 改成那个节点的 tag）
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "手动选择"
      },
      // 直连：所有流量直连，不走任何规则
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "直连"
      },
      {
        "rule_set": "广告拦截",
        "action": "reject"
      },
      {
        "port": 853,
        "action": "reject"
      },
      // 想放行国内 QUIC，把这条移到"国内直连"之后
      {
        "network": "udp",
        "port": 443,
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "直连"
      },
      // 示例：自定义直连域名，照此行加
      {
        "domain_suffix": ["qq.com"],
        "action": "route",
        "outbound": "直连"
      },
      // 示例：自定义代理 IP，照此行加
      {
        "ip_cidr": ["192.0.2.100/32"],
        "action": "route",
        "outbound": "手动选择"
      },
      {
        "rule_set": "苹果域名",
        "action": "route",
        "outbound": "苹果服务"
      },
      {
        "rule_set": "微软域名",
        "action": "route",
        "outbound": "微软服务"
      },
      {
        "rule_set": "谷歌域名",
        "action": "route",
        "outbound": "谷歌服务"
      },
      {
        "rule_set": ["国内域名", "国内IP"],
        "action": "route",
        "outbound": "直连"
      }
    ],
    "rule_set": [
      {
        "tag": "广告拦截",
        "type": "remote",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/217heidai/adblockfilters@main/rules/adblocksingbox.srs",
        "http_client": { "detour": "自动选择" },
        "update_interval": "1d"
      },
      {
        "tag": "国内域名",
        "type": "remote",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-cn.srs",
        "http_client": { "detour": "自动选择" },
        "update_interval": "1d"
      },
      {
        "tag": "国内IP",
        "type": "remote",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/geoip-cn.srs",
        "http_client": { "detour": "自动选择" },
        "update_interval": "1d"
      },
      {
        "tag": "苹果域名",
        "type": "remote",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-apple.srs",
        "http_client": { "detour": "自动选择" },
        "update_interval": "1d"
      },
      {
        "tag": "微软域名",
        "type": "remote",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-microsoft.srs",
        "http_client": { "detour": "自动选择" },
        "update_interval": "1d"
      },
      {
        "tag": "谷歌域名",
        "type": "remote",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-google.srs",
        "http_client": { "detour": "自动选择" },
        "update_interval": "1d"
      }
    ],
    "final": "手动选择",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "本地DNS",
      "strategy": "ipv4_only"
    }
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      // 模式：Rule | Global | Direct
      "default_mode": "Rule"
    }
  }
}
