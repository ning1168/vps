      },
      {
        "type": "remote",
        "tag": "规则集-国内IP",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "download_detour": "直连",
        "update_interval": "1d"
      }
    ],
    "final": "手动选择",
    "auto_detect_interface": true,
    "default_domain_resolver": "本地DNS"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://gcore.jsdelivr.net/gh/MetaCubeX/metacubexd@gh-pages/compressed-dist.zip",
      "external_ui_download_detour": "直连",
      "default_mode": "rule"
    },
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": false
    }
  }
}
