{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "本地DNS"
      },
      {
        "type": "https",
        "tag": "代理DNS",
        "server": "cloudflare-dns.com",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "手动选择",
        "domain_resolver": {
          "server": "本地DNS",
          "strategy": "ipv4_only"
        }
      }
    ],
    "rules": [
      {
        "clash_mode": "direct",
        "action": "route",
        "server": "本地DNS"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "server": "代理DNS"
      },
      {
        "rule_set": "规则集-广告",
        "action": "reject",
        "method": "default"
      },
      {
        "rule_set": [
          "规则集-国内域名",
          "规则集-苹果",
          "规则集-微软"
        ],
        "action": "route",
        "server": "本地DNS"
      },
      {
        "rule_set": "规则集-谷歌",
        "action": "route",
        "server": "代理DNS"
      }
    ],
    "final": "代理DNS",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "直连"
    },
    {
      "type": "selector",
      "tag": "手动选择",
      "outbounds": [
        "自动选择",
        "节点-占位符"
      ],
      "default": "节点-占位符"
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [
        "节点-占位符"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "苹果服务",
      "outbounds": [
        "直连",
        "手动选择",
        "自动选择"
      ],
      "default": "直连"
    },
    {
      "type": "selector",
      "tag": "微软服务",
      "outbounds": [
        "直连",
        "手动选择",
        "自动选择"
      ],
      "default": "直连"
    },
    {
      "type": "selector",
      "tag": "谷歌服务",
      "outbounds": [
        "手动选择",
        "自动选择",
        "直连"
      ],
      "default": "手动选择"
    },
    {
      "type": "shadowsocks",
      "tag": "节点-占位符",
      "server": "127.0.0.1",
      "server_port": 1080,
      "method": "aes-256-gcm",
      "password": "placeholder-will-be-replaced-by-substore"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": "quic",
        "action": "reject"
      },
      {
        "port": 853,
        "action": "reject"
      },
      {
        "rule_set": "规则集-广告",
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "直连"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "outbound": "直连"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "outbound": "手动选择"
      },
      {
        "domain_suffix": "qq.com",
        "action": "route",
        "outbound": "直连"
      },
      {
        "ip_cidr": "192.0.2.100/32",
        "action": "route",
        "outbound": "手动选择"
      },
      {
        "rule_set": "规则集-谷歌",
        "action": "route",
        "outbound": "谷歌服务"
      },
      {
        "rule_set": "规则集-苹果",
        "action": "route",
        "outbound": "苹果服务"
      },
      {
        "rule_set": "规则集-微软",
        "action": "route",
        "outbound": "微软服务"
      },
      {
        "rule_set": "规则集-国内域名",
        "action": "route",
        "outbound": "直连"
      },
      {
        "rule_set": "规则集-国内IP",
        "action": "route",
        "outbound": "直连"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "规则集-广告",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/217heidai/adblockfilters@main/rules/adblocksingbox.srs",
        "download_detour": "直连",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "规则集-国内域名",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
        "download_detour": "直连",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "规则集-谷歌",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-google.srs",
        "download_detour": "直连",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "规则集-苹果",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-apple.srs",
        "download_detour": "直连",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "规则集-微软",
        "format": "binary",
